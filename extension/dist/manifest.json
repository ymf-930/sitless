{
  "manifest_version": 3,
  "name": "走走 · 久坐提醒",
  "version": "0.1.0",
  "description": "按时提醒起身活动，记录今日坐姿时长。记录只在这台电脑上，不上传、不联网。",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage", "idle", "notifications"],
  "background": { "service_worker": "sw.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "走走",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
